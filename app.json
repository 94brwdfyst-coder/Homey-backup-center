{
  "id": "nl.dennisweel.flowbackup",
  "version": "0.4.7",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Backup Center",
    "nl": "Backup Center"
  },
  "description": {
    "en": "Keep your setup safe with simple, reliable backups.",
    "nl": "Houd je instellingen veilig met eenvoudige, betrouwbare back-ups."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#236B55",
  "author": {
    "name": "Dennis Weel"
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getAppInfo": {
      "method": "GET",
      "path": "/app-info"
    },
    "exportBackup": {
      "method": "GET",
      "path": "/export"
    },
    "getWebdav": {
      "method": "GET",
      "path": "/webdav"
    },
    "saveWebdav": {
      "method": "POST",
      "path": "/webdav",
      "body": {
        "config": "string"
      }
    },
    "testWebdav": {
      "method": "POST",
      "path": "/webdav/test",
      "body": {
        "targetId": "string"
      }
    },
    "uploadWebdav": {
      "method": "POST",
      "path": "/webdav/upload",
      "body": {
        "targetId": "string"
      }
    },
    "getSchedule": {
      "method": "GET",
      "path": "/schedule"
    },
    "saveSchedule": {
      "method": "POST",
      "path": "/schedule",
      "body": {
        "config": "object"
      }
    },
    "runScheduleNow": {
      "method": "POST",
      "path": "/schedule/run",
      "body": {
        "targetId": "string"
      }
    },
    "restorePlan": {
      "method": "POST",
      "path": "/restore/plan",
      "body": {
        "backup": "object"
      }
    },
    "restoreRun": {
      "method": "POST",
      "path": "/restore/run",
      "body": {
        "backup": "object",
        "confirm": "boolean",
        "selection": "object"
      }
    },
    "getRestoreAuth": {
      "method": "GET",
      "path": "/restore/auth"
    },
    "saveRestoreAuth": {
      "method": "POST",
      "path": "/restore/auth",
      "body": {
        "token": "string"
      }
    },
    "testRestoreAuth": {
      "method": "POST",
      "path": "/restore/auth/test"
    },
    "saveLanguage": {
      "method": "POST",
      "path": "/language",
      "body": {
        "language": "string"
      }
    },
    "notificationUsers": {
      "method": "GET",
      "path": "/notification-users"
    },
    "startTransfer": {
      "method": "POST",
      "path": "/transfer/start",
      "body": {
        "bytes": "number",
        "kind": "string"
      }
    },
    "appendTransfer": {
      "method": "POST",
      "path": "/transfer/append",
      "body": {
        "id": "string",
        "offset": "number",
        "data": "string"
      }
    },
    "finishTransfer": {
      "method": "POST",
      "path": "/transfer/finish",
      "body": {
        "id": "string"
      }
    },
    "readTransfer": {
      "method": "POST",
      "path": "/transfer/read",
      "body": {
        "id": "string",
        "offset": "number"
      }
    },
    "releaseTransfer": {
      "method": "POST",
      "path": "/transfer/release",
      "body": {
        "id": "string"
      }
    },
    "prepareExport": {
      "method": "POST",
      "path": "/export/prepare"
    },
    "stagedRestorePlan": {
      "method": "POST",
      "path": "/restore/staged-plan",
      "body": {
        "id": "string"
      }
    },
    "stagedRestoreRun": {
      "method": "POST",
      "path": "/restore/staged-run",
      "body": {
        "id": "string",
        "confirm": "boolean",
        "selectionId": "string"
      }
    },
    "getJob": {
      "method": "POST",
      "path": "/job",
      "body": {
        "id": "string"
      }
    },
    "releaseJob": {
      "method": "POST",
      "path": "/job/release",
      "body": {
        "id": "string"
      }
    },
    "getNetwork": {
      "method": "GET",
      "path": "/network"
    },
    "saveNetwork": {
      "method": "POST",
      "path": "/network",
      "body": {
        "target": "object"
      }
    },
    "removeNetwork": {
      "method": "POST",
      "path": "/network/remove",
      "body": {
        "id": "string"
      }
    },
    "testNetwork": {
      "method": "POST",
      "path": "/network/test",
      "body": {
        "id": "string"
      }
    },
    "backupNetwork": {
      "method": "POST",
      "path": "/network/backup",
      "body": {
        "id": "string"
      }
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "contributors": {
    "developers": [
      {
        "name": "Mike_Nono"
      }
    ]
  },
  "flow": {
    "actions": [
      {
        "id": "network_backup",
        "title": {
          "en": "Create backup to network destination",
          "nl": "Maak back-up naar netwerkbestemming"
        },
        "args": [
          {
            "name": "destination",
            "type": "autocomplete",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          }
        ],
        "titleFormatted": {
          "en": "Create backup to network destination [[destination]]",
          "nl": "Maak back-up naar netwerkbestemming [[destination]]"
        }
      }
    ],
    "conditions": [
      {
        "id": "network_destination_reachable",
        "title": {
          "en": "Network destination is writable",
          "nl": "Netwerkbestemming is beschrijfbaar"
        },
        "args": [
          {
            "name": "destination",
            "type": "autocomplete",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          }
        ],
        "titleFormatted": {
          "en": "Network destination is writable [[destination]]",
          "nl": "Netwerkbestemming is beschrijfbaar [[destination]]"
        }
      }
    ],
    "triggers": [
      {
        "id": "network_backup_completed",
        "title": {
          "en": "Network backup completed",
          "nl": "Netwerkback-up geslaagd"
        },
        "args": [
          {
            "name": "destination",
            "type": "autocomplete",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          }
        ],
        "tokens": [
          {
            "name": "destination",
            "type": "string",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          },
          {
            "name": "filename",
            "type": "string",
            "title": {
              "en": "Filename",
              "nl": "Bestandsnaam"
            }
          },
          {
            "name": "bytes",
            "type": "number",
            "title": {
              "en": "Bytes",
              "nl": "Bytes"
            }
          }
        ],
        "titleFormatted": {
          "en": "Network backup completed [[destination]]",
          "nl": "Netwerkback-up geslaagd [[destination]]"
        }
      },
      {
        "id": "network_backup_failed",
        "title": {
          "en": "Network backup failed",
          "nl": "Netwerkback-up mislukt"
        },
        "args": [
          {
            "name": "destination",
            "type": "autocomplete",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          }
        ],
        "tokens": [
          {
            "name": "destination",
            "type": "string",
            "title": {
              "en": "Destination",
              "nl": "Bestemming"
            }
          },
          {
            "name": "error",
            "type": "string",
            "title": {
              "en": "Error",
              "nl": "Fout"
            }
          }
        ],
        "titleFormatted": {
          "en": "Network backup failed [[destination]]",
          "nl": "Netwerkback-up mislukt [[destination]]"
        }
      }
    ]
  }
}
